# URL de la API (la misma que usaba la v1, terminada en /api). La v2 se llama en <VITE_BACKEND_URL>/v2
VITE_BACKEND_URL=https://tu-backend.vercel.app/api
# Opcional: URL completa de la API v2 si está en otro lugar
# VITE_API_V2_URL=https://tu-backend.vercel.app/api/v2

# Dominio público del frontend (sitemap, canonical, Open Graph). Sin barra final.
VITE_SITE_URL=https://tu-frontend.vercel.app

# Google Analytics 4 (G-XXXXXXXXXX). Solo se carga si el visitante acepta las cookies de analítica.
VITE_GA_ID=

# Contacto (botón de WhatsApp, pie de página, datos estructurados)
VITE_WHATSAPP=5939XXXXXXXX
VITE_TELEFONO=
VITE_EMAIL_CONTACTO=
VITE_DIRECCION=
VITE_CIUDAD=
VITE_PROVINCIA=
VITE_FICHA_GOOGLE=
VITE_FACEBOOK=
VITE_INSTAGRAM=
VITE_APP_MOVIL_URL=

# Responsable del sitio (aviso legal y privacidad)
VITE_RAZON_SOCIAL=
VITE_RUC=
VITE_EMAIL_PRIVACIDAD=
