{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/dashboard/:ruta*", "destination": "/app", "permanent": true },
    { "source": "/profesor-dashboard/:ruta*", "destination": "/app", "permanent": true },
    { "source": "/forgot/:id", "destination": "/recuperar", "permanent": true },
    { "source": "/recuperar-password/:token", "destination": "/recuperar", "permanent": true },
    { "source": "/confirmar/:token", "destination": "/login", "permanent": true },
    { "source": "/register", "destination": "/login", "permanent": true }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/recuperar", "destination": "/index.html" },
    { "source": "/aviso-legal", "destination": "/index.html" },
    { "source": "/privacidad", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/v2/activar/:token", "destination": "/index.html" },
    { "source": "/v2/restablecer/:token", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:ruta*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    }
  ]
}
